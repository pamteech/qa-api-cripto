        {
          "name": "CG - preço simples BTC e ETH em USD e BRL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{coingecko_url}}/simple/price?ids=bitcoin,ethereum&vs_currencies=usd,brl&include_last_updated_at=true&include_24hr_change=true",
